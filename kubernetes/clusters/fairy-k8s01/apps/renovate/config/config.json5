// Global (self-hosted) Renovate config for the "Freckle Renovate" GitHub
// App (cockpit C-9). Per-run values come from env: RENOVATE_TOKEN (run.mjs),
// RENOVATE_HOST_RULES (ExternalSecret renovate-host-rules),
// RENOVATE_AUTODISCOVER_FILTER (cronjob.yaml). Repo-level settings belong in each repo's
// .renovaterc.json5 and the shared presets in frecklelabs/k8s//.renovate/.
// The rebase policy is enforced here across existing repo configs (C-1580).
{
  platform: 'github',
  autodiscover: true,
  // A normal global default loses to the explicit behind-base-branch setting
  // in existing repos. force survives repo, manager and package-rule merges.
  // Rebase only on conflicts: moving main must not rebuild every open PR.
  // The automerging repos either use a merge queue or do not require branches
  // to be up to date. If that changes, add a documented per-repository force
  // override in repositories[] for the strict repo without a queue.
  force: {
    rebaseWhen: 'conflicted',
  },
  // A repo without a Renovate config of its own gets one "Configure
  // Renovate" PR adding onboardingConfig as .renovaterc.json5, and nothing
  // else until that PR merges (C-9). The shape matches the configs in ops,
  // network and tofu; a repo can tailor its file in the onboarding PR.
  onboarding: true,
  requireConfig: 'required',
  onboardingConfigFileName: '.renovaterc.json5',
  onboardingConfig: {
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
      'config:recommended',
      'helpers:pinGitHubActionDigests',
      'github>frecklelabs/k8s//.renovate/labels.json5',
      'github>frecklelabs/k8s//.renovate/semanticCommits.json5',
      ':dependencyDashboard',
      ':semanticCommits',
      ':timezone(America/Chicago)',
    ],
    rebaseWhen: 'conflicted',
    dependencyDashboardTitle: 'Renovate Dashboard 🤖',
    mise: {
      enabled: true,
    },
    packageRules: [
      {
        // Renovate PRs are the infra agent's to handle (cockpit C-194);
        // only GitHub Actions updates under .github/ ask for Nicole.
        matchFileNames: ['.github/**'],
        reviewers: ['nicolerenee'],
      },
      {
        matchManagers: ['mise'],
        semanticCommitScope: 'toolchain',
        commitMessageTopic: '{{depName}}',
      },
    ],
  },
  // Commit through the GitHub API, so commits are signed as the App.
  platformCommit: 'enabled',
  // Commands repos may run as postUpgradeTasks (anchored regexes).
  // frecklelabs/k8s re-vendors the gateway-api CRDs after a tag bump; the
  // npm rule below normalizes lockfile URLs.
  allowedCommands: [
    '^scripts/vendor-gateway-api-crds\\.sh$',
    '^node /config/npm-lockfile-registry\\.mjs$',
  ],
  // npm and PyPI lookups through the cluster's package proxy (Go lookups
  // follow GOPROXY from cronjob.yaml). The npmrc also drives npm lockfile
  // updates; a repo's own .npmrc is ignored while this is set.
  npmrc: 'registry=http://package-proxy.dev-platform.svc.cluster.local:8080/npm/',
  // The package proxy is an internal host. Renovate warns on requests to
  // internal hosts today and will refuse them once internalHostAccess
  // defaults to block, unless an admin hostRule allows it. hostRules is a
  // mergeable option, so these are concatenated with the env ones
  // (RENOVATE_HOST_RULES, the ghcr.io credential), not replaced by them.
  hostRules: [
    {
      matchHost: 'package-proxy.dev-platform.svc.cluster.local',
      allowInternal: true,
    },
  ],
  packageRules: [
    {
      matchDatasources: ['pypi'],
      registryUrls: ['http://package-proxy.dev-platform.svc.cluster.local:8080/pypi/simple/'],
    },
    {
      // npm records the proxy's in-cluster tarball URLs in package-lock.json,
      // which CI can't fetch (C-3229). Rewrite them to registry.npmjs.org.
      // Per update, not per branch, so a group led by another manager runs it
      // too; the script is idempotent.
      matchManagers: ['npm'],
      postUpgradeTasks: {
        commands: ['node /config/npm-lockfile-registry.mjs'],
        fileFilters: ['**/package-lock.json', '**/npm-shrinkwrap.json'],
      },
    },
  ],
  binarySource: 'install',
  repositoryCache: 'enabled',
  baseDir: '/tmp/renovate',
}
