// Global (self-hosted) Renovate config for the "Freckle Renovate" GitHub
// App (cockpit C-9). Per-run values come from env: RENOVATE_TOKEN (run.mjs),
// RENOVATE_HOST_RULES (ExternalSecret renovate-host-rules),
// RENOVATE_AUTODISCOVER_FILTER (cronjob.yaml). Repo-level settings belong in each repo's
// .renovaterc.json5 and the shared presets in frecklelabs/k8s//.renovate/,
// not here.
{
  platform: 'github',
  autodiscover: true,
  // A repo without a Renovate config of its own gets one "Configure
  // Renovate" PR adding onboardingConfig as .renovaterc.json5, and nothing
  // else until that PR merges (C-9). The shape matches the configs in ops,
  // network and tofu; a repo can tailor its file in the onboarding PR.
  onboarding: true,
  requireConfig: 'required',
  onboardingConfigFileName: '.renovaterc.json5',
  onboardingConfig: {
    $schema: 'https://docs.renovatebot.com/renovate-schema.json',
    extends: [
      'config:recommended',
      'helpers:pinGitHubActionDigests',
      'github>frecklelabs/k8s//.renovate/labels.json5',
      'github>frecklelabs/k8s//.renovate/semanticCommits.json5',
      ':dependencyDashboard',
      ':semanticCommits',
      ':timezone(America/Chicago)',
    ],
    rebaseWhen: 'behind-base-branch',
    dependencyDashboardTitle: 'Renovate Dashboard 🤖',
    mise: {
      enabled: true,
    },
    packageRules: [
      {
        // Renovate PRs are the infra agent's to handle (cockpit C-194);
        // only GitHub Actions updates under .github/ ask for Nicole.
        matchFileNames: ['.github/**'],
        reviewers: ['nicolerenee'],
      },
      {
        matchManagers: ['mise'],
        semanticCommitScope: 'toolchain',
        commitMessageTopic: '{{depName}}',
      },
    ],
  },
  // Commit through the GitHub API, so commits are signed as the App.
  platformCommit: 'enabled',
  // Commands repos may run as postUpgradeTasks (anchored regexes).
  // frecklelabs/k8s re-vendors the gateway-api CRDs after a tag bump.
  allowedCommands: [
    '^scripts/vendor-gateway-api-crds\\.sh$',
  ],
  // npm and PyPI lookups through the cluster's package proxy (Go lookups
  // follow GOPROXY from cronjob.yaml). The npmrc also drives npm lockfile
  // updates; a repo's own .npmrc is ignored while this is set.
  npmrc: 'registry=http://package-proxy.dev-platform.svc.cluster.local:8080/npm/',
  packageRules: [
    {
      matchDatasources: ['pypi'],
      registryUrls: ['http://package-proxy.dev-platform.svc.cluster.local:8080/pypi/simple/'],
    },
  ],
  binarySource: 'install',
  repositoryCache: 'enabled',
  baseDir: '/tmp/renovate',
}
